# ============================================================================
# 天工 内网部署配置示例
# ============================================================================
# 用法:
#   1. 复制为 .env.production:  cp .env.production.example .env.production
#   2. 按本文件注释填入真实值(尤其标 [必改] 的项)
#   3. 部署: docker compose --env-file .env.production up -d --build
#
# 说明:
#   - 容器间用服务名访问(postgres / minio / api / web),不是 localhost
#   - [必改] 项每套环境都要换;其余项有合理默认可不动
#   - COOKIE_DOMAIN / CORS_ORIGINS / INTRANET_URL 三者要指向同一个内网地址
#     (见 docs/deploy-internal.md「跨 host cookie 传递」一节,GOTCHAS F4)
# ============================================================================

# ---- 数据库(容器间用服务名 postgres)----
DATABASE_URL=postgresql+psycopg://tiangong:tiangong@postgres:5432/tiangong
TEST_DATABASE_URL=postgresql+psycopg://tiangong:tiangong@postgres:5432/tiangong_test

# ---- 内网访问地址 [必改] ----
# 团队浏览器访问 Web 的地址(主机名或 IP,不带端口:3000 由 compose 暴露)
# 示例: http://192.168.1.100  或  http://intranet.yourcorp.local
INTRANET_URL=http://intranet.yourcorp.local

# ---- Cookie / CORS(由 INTRANET_URL 派生,保持一致)----
# 内网 HTTP 无 HTTPS → secure=false;若后续加反代 + HTTPS 则改 true
COOKIE_DOMAIN=intranet.yourcorp.local
COOKIE_SECURE=false
CORS_ORIGINS=http://intranet.yourcorp.local

# ---- 安全密钥 [必改] ----
# JWT 签名密钥:64 字符随机串。生成: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-64-char-string
# LLM key 等敏感字段加密密钥:base64 编码的 32 字节。生成: openssl rand -base64 32
ENCRYPTION_KEY=change-me-base64-32-byte-key

# ---- JWT 策略(一般不动)----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 对象存储(容器间用服务名 minio)----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tiangong
# [必改] 生产环境务必改 MinIO root 密码
MINIO_SECRET_KEY=tiangong12345
MINIO_BUCKET_PERSONAL=tiangong-personal
MINIO_BUCKET_GLOBAL=tiangong-global
MINIO_SECURE=false

# ---- LLM chat(GLM via OpenAI 兼容协议)[必改] ----
# 全局默认 chat Key;用户也可在设置页配自己的自定义配置覆盖
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.7

# ---- Embedding(走 bge-m3 微服务)[按部署改] ----
# 由 docker-compose.yml 的 embedding 服务提供(Infinity 跑 BAAI/bge-m3)。
# Infinity 端点是 /embeddings(无 /v1 前缀),故 base_url 不带 /v1。
# 容器内 api 用 http://embedding:7997;若用外部托管服务则改此处。
EMBEDDING_BASE_URL=http://embedding:7997
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# ---- Rerank(走 bge-reranker-v2-m3 微服务)[按部署改] ----
# 由 docker-compose.yml 的 rerank 服务提供(Infinity 跑 BAAI/bge-reranker-v2-m3)。
# 与 embedding 对称,容器内 api 用 http://rerank:7998;若用外部托管服务则改此处。
# rerank 是 fail-open 设计(服务挂了检索降级原序),RERANK_ENABLED=false 可临时关闭。
RERANK_ENABLED=true
RERANK_BASE_URL=http://rerank:7998
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=

# ---- drawio 渲染(走 drawio-desktop headless 微服务)[按部署改] ----
# 由 docker-compose.yml 的 drawio 服务提供(draw.io desktop CLI + xvfb + Chromium)。
# 容器内 api 用 http://drawio:8001;若用外部托管服务则改此处。
# 软依赖且 fail-closed:服务挂了「附图生成」功能报 503,不影响主功能。
DRAWIO_BASE_URL=http://drawio:8001

# ---- 首个管理员账号 ----
# API 容器启动时由 entrypoint 自动创建(已存在则跳过)。
# 三个都填才会建;留空则不建 admin(后续可用 scripts.create_admin 手动建)。
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=change-me-to-a-strong-password
INIT_ADMIN_EMAIL=admin@tiangong.dev

# ---- 前端 build 时注入(Next.js NEXT_PUBLIC_* 在 build 阶段内联)----
# 容器内 web → api 用服务名 api:8000;但浏览器侧由 INTRANET_URL 决定
# 若 web 与 api 同源(反代合并)可省;内网直连场景填 api 的可达地址
NEXT_PUBLIC_API_URL=http://intranet.yourcorp.local:8000
