# 项目数据（本地存储，勿提交）
uploads/
storage/

# 运行时日志（loguru 文件 sink 落盘，见 app/core/logging.py）
logs/
*.log

# 预下载的 ML 模型（bge-m3 等，~2.3GB，用户本地准备，勿提交）
# 注意：前导 / 锚定项目根，避免误伤 apps/api/app/models（ORM 数据模型目录）
/models/

# 上传文件（MVP 本地存储）
apps/api/uploads/

# 测试产物（sqlite 本地文件库）
apps/api/test.db
apps/api/*.db

# Git worktrees（隔离工作区，skill: using-git-worktrees）
.worktrees/
.worktree/

# 工具私有目录(zcode agent 本地文件)
.zcode/

# superpowers 工具缓存（brainstorm 等本地文件）
.superpowers/

# 生产配置(含密钥,勿提交)
.env.production
