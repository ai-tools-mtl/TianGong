# 数据库
DATABASE_URL=postgresql+psycopg://tiangong:tiangong@localhost:5432/tiangong
TEST_DATABASE_URL=postgresql+psycopg://tiangong:tiangong@localhost:5432/tiangong_test

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# 加密（用于 LLM key 等敏感字段）
ENCRYPTION_KEY=change-me-base64-32-byte-key

# CORS
CORS_ORIGINS=http://localhost:3000

# 对象存储（minio，S3 兼容）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=tiangong
MINIO_SECRET_KEY=tiangong12345
MINIO_BUCKET_PERSONAL=tiangong-personal
MINIO_BUCKET_GLOBAL=tiangong-global
MINIO_SECURE=false

# LLM chat（GLM via OpenAI 兼容协议，env 兜底用；主配置走 admin 全局/用户自配）
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.7

# Embedding（统一走 bge-m3 微服务）
# 先 docker compose up -d embedding 起服务，再填此地址。
# Infinity 端点是 /embeddings（无 /v1 前缀），故 base_url 不带 /v1。
# 本地开发用 localhost；容器内部署用 http://embedding:7997。
EMBEDDING_BASE_URL=http://localhost:7997
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=

# Rerank（统一走 bge-reranker-v2-m3 微服务，与 embedding 对称）
# 先 docker compose up -d rerank 起服务，再填此地址。
# Infinity 端点是 /rerank（无 /v1 前缀）。本地开发用 localhost；容器内部署用 http://rerank:7998。
# 本地服务通常不校验 api_key，留空。
# rerank 是 fail-open 设计（服务挂了检索降级原序），RERANK_ENABLED=false 可临时关闭。
RERANK_ENABLED=true
RERANK_BASE_URL=http://localhost:7998
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_KEY=
